# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# 4 space indentation for JS, TS and JSON
[*.{js,ts,json}]
indent_style = space
indent_size = 4

# 2 space indentation for other files (if any)
[*.{html,css,yml,yaml}]
indent_style = space
indent_size = 2
